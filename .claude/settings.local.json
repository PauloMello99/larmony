{
  "permissions": {
    "allow": [
      "PowerShell(Invoke-RestMethod -Uri \"http://localhost:3001/health\" -Method Get)",
      "PowerShell($r = Invoke-WebRequest -Uri \"http://localhost:3000\" -UseBasicParsing; $r.StatusCode)",
      "PowerShell(Get-Process -Id \\(Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue\\).OwningProcess -ErrorAction SilentlyContinue | Select-Object Id, ProcessName)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm check-types)",
      "PowerShell(git add -A)",
      "Bash(pnpm add *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "mcp__railway__list_projects"
    ]
  },
  "enableAllProjectMcpServers": true
}
