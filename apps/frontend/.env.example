# URL pública do backend NestJS. O client de API e o download de CSV usam esta
# var (fallback http://localhost:3001 em dev). No Railway é BUILD-TIME (o Next
# inlina no bundle) — setar como variável do serviço frontend, por ambiente:
#  - staging:    https://<backend-staging>.up.railway.app
#  - production: https://<backend-prod>.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública e canônica do site (landing). Usada para gerar URLs absolutas em
# meta tags (og:url, canonical), robots.txt (Sitemap:) e sitemap.xml. Também é
# BUILD-TIME (Next inlina no bundle) — setar como variável do serviço frontend:
#  - dev local:  http://localhost:3000
#  - staging:    https://<frontend-staging>.up.railway.app
#  - production: https://larmony.me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error tracking — Better Stack (Telemetry). Source da application "frontend"
# (id 2554582). Prefixo NEXT_PUBLIC_ → BUILD-TIME (inlinado no bundle do
# browser); setar por ambiente no serviço frontend. Sem AMBAS as vars a
# telemetria vira no-op. Pegue token + ingesting host em: Better Stack →
# Sources → frontend → Configure.
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_URL=https://<ingesting-host>.betterstackdata.com
# Opcional — nível mínimo de log enviado (debug|info|warn|error). Default: info.
NEXT_PUBLIC_BETTER_STACK_LOG_LEVEL=info
