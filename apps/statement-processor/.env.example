# Segredo compartilhado com o backend NestJS — mesma env dos dois lados
# (ADR-0034). Usado tanto pra autenticar POST /jobs (backend->processor)
# quanto o callback (processor->backend).
PROCESSOR_SHARED_SECRET=

# Porta do serviço (Railway injeta PORT automaticamente em produção).
PORT=8000

# Chave da Groq usada só pelo processor (não compartilhada com o backend)
# pro fallback LLM da Fase 4 (ADR-0033). OPCIONAL — sem ela, a Fase 4 fica
# desligada e o pipeline se comporta como nas Fases 1-3 (transações sem
# resolução de regra ficam unresolved, sem tentar LLM).
GROQ_API_KEY=
