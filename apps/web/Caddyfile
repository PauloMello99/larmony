:{$PORT:80} {
    root * /srv

    # Compression
    encode gzip zstd

    # SPA fallback: any path not matching a real file serves index.html
    # so the client-side router (TanStack Router) handles the route
    try_files {path} /index.html

    file_server

    # Hashed assets (e.g. assets/index-abc12345.js) → cache forever
    @hashed {
        path /assets/*
    }
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    # index.html → never cache (ensures users always get the latest deploy)
    header /index.html Cache-Control "no-cache, no-store, must-revalidate"
}
